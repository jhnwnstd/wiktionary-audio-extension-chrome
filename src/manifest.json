{
  "name": "Wiktionary Audio Downloader",
  "description": "Download Wiktionary pronunciation audio. Save the original file or convert to WAV locally with FFmpeg.wasm.",
  "version": "1.3.4",
  "manifest_version": 3,
  "homepage_url": "https://github.com/jhnwnstd/wiktionary-audio-extension-chrome",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "downloads",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://*.wiktionary.org/*",
    "https://upload.wikimedia.org/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self';"
  },
  "content_scripts": [
    {
      "matches": ["https://*.wiktionary.org/*"],
      "js": ["content-script.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/*.mjs", "shared/*.mjs"],
      "matches": ["https://*.wiktionary.org/*"]
    }
  ]
}